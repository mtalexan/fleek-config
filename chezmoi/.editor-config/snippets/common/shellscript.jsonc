{
	// Place your snippets for shellscript here. Each snippet is defined under a snippet name and has a prefix, body and 
	// description. The prefix is what is used to trigger the snippet and the body will be expanded and inserted. Possible variables are:
	// $1, $2 for tab stops, $0 for the final cursor position, and ${1:label}, ${2:another} for placeholders. Placeholders with the 
	// same ids are connected.
	// Example:
	// "Print to console": {
	// 	"prefix": "log",
	// 	"body": [
	// 		"console.log('$1');",
	// 		"$2"
	// 	],
	// 	"description": "Log output to console"
	// }

	"Command-line options via getopt": {
	"prefix": "getopt",
	"body": [
		"# example argument used here",
		"print_usage()",
		"{",
		"	echo \"USAGE:\"",
		"	echo \" \\${0} [opts]\"",
		"	echo \"\"",
		"	echo \" Options:\"",
		"	echo \"   -h\"",
		"	echo \"   --help\"",
		"	echo \"     Print this help text.\"",
		"	echo \"   -f\\\"filename\\\"\"",
		"	echo \"   --file=\\\"filename\\\"\"",
		"	echo \"     File to parse the raw Excel column data from.  Data should be a copy-paste of an entire\"",
		"	echo \"     Excel column into a text file.  Required argument.\"",
		"	echo \"\"",
		"}",
		"",
		"# We need to temporarily allow non-zero exit codes so we can handle it from getopt independently from the",
		"# text output that's returned.",
		"set +e",
		"OPTS=\\$(getopt -n \"\\$(basename \\${0})\" --options hf: --longoptions help,file: -- \"\\$@\")\"",
		"if [ \\$? -ne 0 ]",
		"then",
		"	echo \"ERROR: Unable to parse arguments\"",
		"	print_usage",
		"	exit 1",
		"fi",
		"set -e",
		"",
		"eval set -- \"\\${OPTS}\"",
		"",
		"# defaults",
		"# Interface via environment variables when invoked.  Valid ways to set them are (y or 1) and (n or 0), but",
		"# they will be modified by command-line arguments if there's a conflict.",
		"ID_FILE=\\${ID_FILE:-}",
		"",
		"FREE_ARGS=0",
		"ALL_FREE_ARGS=false",
		"",
		"while [ -n \"\\${1:-}\" ]",
		"do",
		"	case \"\\${1}\" in",
		"		-h | --help)",
		"			print_usage",
		"			exit 0",
		"			;;",
		"		-f | --file )",
		"			ID_FILE=\"\\${2}\"",
		"			shift 2",
		"			;;",
		"# If not using free arguments",
		"		--)",
		"			# end of argument list, do nothing",
		"			shift",
		"			;;",
		"		*)",
		"			echo \"ERROR: Unrecognized argument: \\${1}\"",
		"			print_usage",
		"			exit 1",
		"			;;",
		"# alternative if free arguments are in use",
		"		--)",
		"			# anything else is a free argument",
		"			ALL_FREE_ARGS=true",
		"			shift",
		"			;;",
		"		*)",
		"			if ! \\${ALL_FREE_ARGS}",
		"			then",
		"				echo \"ERROR: Unrecognized argument: \\${1}\"",
		"				print_usage",
		"				exit 1",
		"			else",
		"				FREE_ARGS=\\$(expr \"\\${FREE_ARGS}\" \"+\" \"1\")",
		"				case \\${FREE_ARGS} in",
		"					1)",
		"						#process first free argument here",
		"						#contained in \\${1}",
		"						;;",
		"					*)",
		"						# too many free arguments, error our",
		"						echo \"ERROR: Too many arguments\"",
		"						print_usage",
		"						exit 1",
		"						;;",
		"				esac",
		"				# we handled the argument, move to the next one",
		"				shift",
		"			fi",
		"			;;",
		"	esac",
		"done",
	],
	"description": "A shell script template for getopt argument parsing"
	}
}